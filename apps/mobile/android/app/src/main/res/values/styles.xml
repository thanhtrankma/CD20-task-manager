<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Giao diện khi khởi động: nền trắng có logo (launch_background). Dùng Theme.AppCompat theo yêu cầu của
         local_auth (hộp xác thực vân tay trên Android 8 trở xuống). Ứng dụng chỉ có giao diện sáng. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Nền cửa sổ phía sau giao diện Flutter khi đang chạy. -->
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
