// Schema CSDL phần mềm quản lý giao việc.
// Thay đổi cấu trúc: sửa file này rồi chạy `npm run prisma:migrate -- --name <ten-thay-doi>`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Chuỗi kết nối nằm trong prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // Quản trị hệ thống: quản lý tài khoản, đơn vị; không xem nội dung công việc
  LEADER // Ban Giám hiệu: toàn trường
  UNIT_HEAD // Chỉ huy đơn vị: đơn vị mình và đơn vị trực thuộc
  STAFF // Cán bộ, giảng viên: việc được giao cho mình
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  PENDING_REVIEW
  RETURNED
  DONE
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AssigneeRole {
  LEAD // Chủ trì
  SUPPORT // Phối hợp
}

enum ReviewStatus {
  PENDING
  APPROVED
  RETURNED
}

enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationType {
  DIRECT // Nhắn riêng 1 – 1
  GROUP // Nhóm tự tạo
  UNIT // Nhóm theo đơn vị: thành viên tính theo đơn vị của tài khoản, không lưu danh sách
}

enum ConversationRole {
  OWNER
  MEMBER
}

enum MessageKind {
  TEXT
  SYSTEM // Dòng thông báo trong nhóm: tạo nhóm, thêm, bớt người, đổi tên
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum PushProvider {
  FCM // Firebase Cloud Messaging (Android; iOS qua Firebase)
  APNS // Gửi thẳng tới Apple
}

// Dòng hoạt động của nhiệm vụ (hiển thị trong chi tiết). Không lưu nội dung bình luận, báo cáo.
// Đơn nghỉ phép: chỉ huy đơn vị duyệt; nghỉ quá ngưỡng ngày (cài đặt leaveEscalateDays) chuyển lên lãnh đạo.
enum LeaveStatus {
  PENDING_UNIT // Chờ chỉ huy đơn vị duyệt
  PENDING_LEADER // Chờ lãnh đạo nhà trường duyệt
  APPROVED
  REJECTED
  CANCELLED // Người gửi rút khi chưa duyệt xong
  REVOKED // Hủy sau khi đã duyệt (hoàn lại ngày phép)
}

// Phần ngày nghỉ: cả ngày, buổi sáng hoặc buổi chiều.
enum DayPart {
  FULL
  MORNING
  AFTERNOON
}

enum PunchSource {
  IMPORT // Nhập tệp xuất từ máy hoặc phần mềm chấm công
  DEVICE // Máy chấm công gửi thẳng (làm sau)
}

enum TaskActivityType {
  CREATED
  ACKNOWLEDGED
  PROGRESS
  SUBMITTED
  APPROVED
  RETURNED
  UPDATED
  CANCELLED
  NUDGED
  EXTENSION_REQUESTED
  EXTENSION_APPROVED
  EXTENSION_REJECTED
  FOLLOWED
}

model Unit {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  parentId    Int?     @map("parent_id")
  isActive    Boolean  @default(true) @map("is_active")
  /// Ca làm việc riêng của đơn vị; không gán thì theo đơn vị cấp trên, cuối cùng là ca mặc định.
  workShiftId Int?     @map("work_shift_id")
  createdAt   DateTime @default(now()) @map("created_at")

  parent         Unit?          @relation("UnitTree", fields: [parentId], references: [id])
  children       Unit[]         @relation("UnitTree")
  users          User[]
  assignments    TaskAssignee[]
  chatGroup      Conversation?
  workShift      WorkShift?     @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  leaveApprovals LeaveRequest[]

  @@map("units")
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique
  fullName           String    @map("full_name")
  rank               String? // Cấp bậc
  position           String? // Chức vụ
  email              String? // Nhận nhắc việc qua thư điện tử (nên dùng hộp thư nội bộ)
  unitId             Int       @map("unit_id")
  role               Role      @default(STAFF)
  passwordHash       String    @map("password_hash")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  totpSecret         String?   @map("totp_secret")
  totpEnabled        Boolean   @default(false) @map("totp_enabled")
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until")
  isActive           Boolean   @default(true) @map("is_active")
  lastLoginAt        DateTime? @map("last_login_at")
  /// Tên tệp ảnh đại diện (ngẫu nhiên) trong thư mục uploads/avatars.
  avatarFile         String?   @map("avatar_file")
  /// Phụ trách nhân sự – chấm công: nhập dữ liệu chấm công, quản lý quỹ phép, xem toàn trường. Quản trị bật.
  hrManager          Boolean   @default(false) @map("hr_manager")
  /// Đối tượng (sĩ quan, QNCN, CNVQP, hợp đồng…): quyết định số ngày phép mặc định.
  staffCategoryId    Int?      @map("staff_category_id")
  /// Mã nhân viên trên máy chấm công.
  attendanceCode     String?   @unique @map("attendance_code") @db.VarChar(32)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  unit                 Unit                 @relation(fields: [unitId], references: [id])
  sessions             Session[]
  createdTasks         Task[]               @relation("TaskCreator")
  assignments          TaskAssignee[]       @relation("Assignee")
  acknowledgements     TaskAssignee[]       @relation("Acknowledger")
  follows              TaskFollower[]
  activities           TaskActivity[]
  taskUpdates          TaskUpdate[]
  submissions          Submission[]         @relation("Submitter")
  reviews              Submission[]         @relation("Reviewer")
  extensionRequests    ExtensionRequest[]   @relation("Requester")
  extensionDecisions   ExtensionRequest[]   @relation("Decider")
  attachments          Attachment[]
  comments             Comment[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  devices              Device[]
  auditLogs            AuditLog[]
  conversationsMade    Conversation[]
  memberships          ConversationMember[]
  messages             Message[]
  staffCategory        StaffCategory?       @relation(fields: [staffCategoryId], references: [id], onDelete: SetNull)
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]       @relation("LeaveRequester")
  leaveUnitDecisions   LeaveRequest[]       @relation("LeaveUnitDecider")
  leaveLeaderDecisions LeaveRequest[]       @relation("LeaveLeaderDecider")
  leaveRevocations     LeaveRequest[]       @relation("LeaveRevoker")
  punches              AttendancePunch[]
  attendanceImports    AttendanceImport[]

  @@index([unitId])
  @@map("users")
}

// Phiên đăng nhập. `id` là SHA-256 của token trong cookie; token gốc không lưu trong CSDL.
model Session {
  id        String   @id
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices Device[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Điện thoại cài ứng dụng, nhận thông báo đẩy. Gắn với phiên đăng nhập: đăng xuất, phiên hết hạn hoặc bị thu hồi
// thì thiết bị tự bị xóa (không còn nhận nhắc việc của tài khoản đó).
model Device {
  id         Int            @id @default(autoincrement())
  userId     Int            @map("user_id")
  sessionId  String         @map("session_id")
  platform   DevicePlatform
  provider   PushProvider
  token      String         @unique @db.VarChar(512)
  appVersion String?        @map("app_version") @db.VarChar(32)
  createdAt  DateTime       @default(now()) @map("created_at")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?    @db.Text
  /// Căn cứ giao nhiệm vụ: số, ký hiệu, ngày văn bản hoặc kết luận giao ban (chỉ số hiệu, trích yếu).
  source      String?    @db.VarChar(500)
  createdById Int        @map("created_by_id")
  dueDate     DateTime   @map("due_date")
  priority    Priority   @default(NORMAL)
  status      TaskStatus @default(NEW)
  progress    Int        @default(0) // 0–100
  parentId    Int?       @map("parent_id")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  createdBy         User               @relation("TaskCreator", fields: [createdById], references: [id])
  parent            Task?              @relation("Subtasks", fields: [parentId], references: [id])
  children          Task[]             @relation("Subtasks")
  assignees         TaskAssignee[]
  followers         TaskFollower[]
  activities        TaskActivity[]
  updates           TaskUpdate[]
  submissions       Submission[]
  extensionRequests ExtensionRequest[]
  attachments       Attachment[]
  comments          Comment[]

  @@index([status])
  @@index([dueDate])
  @@index([createdById])
  @@map("tasks")
}

// Người nhận việc: hoặc một cá nhân (userId), hoặc một đơn vị (unitId).
model TaskAssignee {
  id               Int          @id @default(autoincrement())
  taskId           Int          @map("task_id")
  userId           Int?         @map("user_id")
  unitId           Int?         @map("unit_id")
  role             AssigneeRole @default(LEAD)
  /// Thời điểm người được giao (hoặc chỉ huy đơn vị được giao) xác nhận đã nhận nhiệm vụ.
  acknowledgedAt   DateTime?    @map("acknowledged_at")
  acknowledgedById Int?         @map("acknowledged_by_id")

  task           Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User? @relation("Assignee", fields: [userId], references: [id])
  unit           Unit? @relation(fields: [unitId], references: [id])
  acknowledgedBy User? @relation("Acknowledger", fields: [acknowledgedById], references: [id])

  @@index([taskId])
  @@index([userId])
  @@index([unitId])
  @@map("task_assignees")
}

// Người theo dõi: nắm tình hình, nhận thông báo, không phải thực hiện.
model TaskFollower {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_followers")
}

model TaskActivity {
  id        Int              @id @default(autoincrement())
  taskId    Int              @map("task_id")
  userId    Int              @map("user_id")
  type      TaskActivityType
  detail    Json?
  createdAt DateTime         @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
  @@map("task_activities")
}

model TaskUpdate {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  progress  Int
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_updates")
}

model Submission {
  id            Int          @id @default(autoincrement())
  taskId        Int          @map("task_id")
  submittedById Int          @map("submitted_by_id")
  content       String       @db.Text
  status        ReviewStatus @default(PENDING)
  reviewerId    Int?         @map("reviewer_id")
  reviewNote    String?      @map("review_note") @db.Text
  reviewedAt    DateTime?    @map("reviewed_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy User         @relation("Submitter", fields: [submittedById], references: [id])
  reviewer    User?        @relation("Reviewer", fields: [reviewerId], references: [id])
  attachments Attachment[]

  @@index([taskId])
  @@map("submissions")
}

model ExtensionRequest {
  id            Int             @id @default(autoincrement())
  taskId        Int             @map("task_id")
  requestedById Int             @map("requested_by_id")
  oldDueDate    DateTime?       @map("old_due_date")
  newDueDate    DateTime        @map("new_due_date")
  reason        String          @db.Text
  decisionNote  String?         @map("decision_note") @db.Text
  status        ExtensionStatus @default(PENDING)
  decidedById   Int?            @map("decided_by_id")
  decidedAt     DateTime?       @map("decided_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("Requester", fields: [requestedById], references: [id])
  decidedBy   User? @relation("Decider", fields: [decidedById], references: [id])

  @@index([taskId])
  @@map("extension_requests")
}

model Attachment {
  id           Int      @id @default(autoincrement())
  taskId       Int?     @map("task_id")
  submissionId Int?     @map("submission_id")
  uploadedById Int      @map("uploaded_by_id")
  originalName String   @map("original_name")
  storedName   String   @unique @map("stored_name") // Tên ngẫu nhiên trên đĩa
  mimeType     String   @map("mime_type")
  size         Int
  sha256       String
  createdAt    DateTime @default(now()) @map("created_at")

  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation(fields: [uploadedById], references: [id])

  @@index([taskId])
  @@index([submissionId])
  @@map("attachments")
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int      @map("task_id")
  userId    Int      @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("comments")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// Thiết bị (trình duyệt, điện thoại) đã bật nhận thông báo đẩy (Web Push).
model PushSubscription {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Nhật ký thao tác: chỉ ghi thêm. Trigger trong migration audit_log_append_only chặn UPDATE, DELETE, TRUNCATE
// (vì vậy không xóa được tài khoản đã có nhật ký: chỉ vô hiệu hóa).
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  ip        String?
  userAgent String?  @map("user_agent")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// Trò chuyện nội bộ. Quản trị (ADMIN) không tham gia.
model Conversation {
  id              Int              @id @default(autoincrement())
  type            ConversationType
  name            String?          @db.VarChar(100)
  /// Nhóm theo đơn vị: mỗi đơn vị tối đa một nhóm.
  unitId          Int?             @unique @map("unit_id")
  includeSubunits Boolean          @default(false) @map("include_subunits")
  /// Nhắn riêng: "<id nhỏ>:<id lớn>" để không tạo trùng.
  directKey       String?          @unique @map("direct_key")
  createdById     Int              @map("created_by_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  lastMessageAt   DateTime?        @map("last_message_at")

  unit      Unit?                @relation(fields: [unitId], references: [id])
  createdBy User                 @relation(fields: [createdById], references: [id])
  members   ConversationMember[]
  messages  Message[]

  @@index([lastMessageAt])
  @@map("conversations")
}

/// Thành viên nhóm tự tạo, nhắn riêng. Với nhóm theo đơn vị chỉ lưu trạng thái đã đọc, tắt thông báo.
model ConversationMember {
  conversationId    Int              @map("conversation_id")
  userId            Int              @map("user_id")
  role              ConversationRole @default(MEMBER)
  lastReadMessageId Int              @default(0) @map("last_read_message_id")
  muted             Boolean          @default(false)
  joinedAt          DateTime         @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             Int         @id @default(autoincrement())
  conversationId Int         @map("conversation_id")
  senderId       Int?        @map("sender_id")
  kind           MessageKind @default(TEXT)
  body           String      @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  /// Thu hồi: xóa nội dung, giữ dòng để thứ tự, số chưa đọc không đổi.
  deletedAt      DateTime?   @map("deleted_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id])

  @@index([conversationId, id])
  @@map("messages")
}

// ---------- Nghỉ phép ----------

model StaffCategory {
  id         Int    @id @default(autoincrement())
  name       String @unique
  /// Số ngày phép năm mặc định.
  annualDays Float  @default(12) @map("annual_days")
  sortOrder  Int    @default(0) @map("sort_order")

  users User[]

  @@map("staff_categories")
}

model LeaveType {
  id             Int     @id @default(autoincrement())
  code           String  @unique
  name           String
  /// Trừ vào quỹ phép năm.
  deductsBalance Boolean @default(false) @map("deducts_balance")
  isActive       Boolean @default(true) @map("is_active")
  sortOrder      Int     @default(0) @map("sort_order")

  requests LeaveRequest[]

  @@map("leave_types")
}

// Quỹ phép từng người theo năm. entitledDays trống: lấy theo đối tượng.
model LeaveBalance {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  year         Int
  entitledDays Float?   @map("entitled_days")
  /// Phép tồn chuyển từ năm trước.
  carriedDays  Float    @default(0) @map("carried_days")
  note         String?  @db.VarChar(500)
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id                Int         @id @default(autoincrement())
  userId            Int         @map("user_id")
  typeId            Int         @map("type_id")
  startDate         DateTime    @map("start_date") @db.Date
  endDate           DateTime    @map("end_date") @db.Date
  /// Ngày đầu: cả ngày hoặc chỉ buổi chiều (đơn một ngày: cả ngày, sáng hoặc chiều).
  startPart         DayPart     @default(FULL) @map("start_part")
  /// Ngày cuối: cả ngày hoặc chỉ buổi sáng.
  endPart           DayPart     @default(FULL) @map("end_part")
  /// Số ngày làm việc nghỉ (đã bỏ ngày nghỉ hằng tuần, ngày lễ), tính lúc gửi đơn.
  days              Float
  reason            String      @db.Text
  status            LeaveStatus
  /// Đơn vị có chỉ huy duyệt cấp 1; trống khi đơn lên thẳng lãnh đạo.
  approverUnitId    Int?        @map("approver_unit_id")
  /// Cần lãnh đạo duyệt sau chỉ huy đơn vị.
  needsLeader       Boolean     @default(false) @map("needs_leader")
  unitDecidedById   Int?        @map("unit_decided_by_id")
  unitDecidedAt     DateTime?   @map("unit_decided_at")
  leaderDecidedById Int?        @map("leader_decided_by_id")
  leaderDecidedAt   DateTime?   @map("leader_decided_at")
  /// Lý do từ chối, ghi chú khi duyệt hoặc khi hủy duyệt.
  decisionNote      String?     @map("decision_note") @db.Text
  revokedById       Int?        @map("revoked_by_id")
  revokedAt         DateTime?   @map("revoked_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user            User      @relation("LeaveRequester", fields: [userId], references: [id])
  type            LeaveType @relation(fields: [typeId], references: [id])
  approverUnit    Unit?     @relation(fields: [approverUnitId], references: [id])
  unitDecidedBy   User?     @relation("LeaveUnitDecider", fields: [unitDecidedById], references: [id])
  leaderDecidedBy User?     @relation("LeaveLeaderDecider", fields: [leaderDecidedById], references: [id])
  revokedBy       User?     @relation("LeaveRevoker", fields: [revokedById], references: [id])

  @@index([userId, startDate])
  @@index([status])
  @@index([approverUnitId, status])
  @@map("leave_requests")
}

// ---------- Chấm công ----------

model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @db.Date
  name String

  @@map("holidays")
}

model WorkShift {
  id           Int     @id @default(autoincrement())
  name         String
  /// Giờ vào, giờ ra dạng "HH:mm" theo giờ Việt Nam.
  startTime    String  @map("start_time") @db.VarChar(5)
  endTime      String  @map("end_time") @db.VarChar(5)
  /// Nghỉ trưa: mốc tính nửa ngày (nghỉ buổi sáng thì vào trước breakEnd, nghỉ buổi chiều thì ra sau breakStart).
  breakStart   String  @default("11:30") @map("break_start") @db.VarChar(5)
  breakEnd     String  @default("13:30") @map("break_end") @db.VarChar(5)
  /// Số phút cho phép đi muộn, về sớm.
  graceMinutes Int     @default(5) @map("grace_minutes")
  /// Ngày làm việc trong tuần: 1 = thứ Hai … 7 = Chủ nhật.
  workdays     Int[]   @default([1, 2, 3, 4, 5])
  isDefault    Boolean @default(false) @map("is_default")

  units Unit[]

  @@map("work_shifts")
}

// Một lượt chấm công: chỉ mã nhân viên và thời điểm (không lấy dữ liệu vân tay, khuôn mặt).
model AttendancePunch {
  id        Int         @id @default(autoincrement())
  code      String      @db.VarChar(32)
  punchedAt DateTime    @map("punched_at")
  /// Tài khoản có mã này; trống khi mã chưa được ghép.
  userId    Int?        @map("user_id")
  source    PunchSource @default(IMPORT)
  importId  Int?        @map("import_id")
  createdAt DateTime    @default(now()) @map("created_at")

  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  importedBy AttendanceImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([code, punchedAt])
  @@index([userId, punchedAt])
  @@map("attendance_punches")
}

model AttendanceImport {
  id           Int       @id @default(autoincrement())
  fileName     String    @map("file_name")
  uploadedById Int       @map("uploaded_by_id")
  total        Int
  inserted     Int
  duplicates   Int
  /// Số lượt có mã chưa ghép với tài khoản.
  unmatched    Int
  rangeFrom    DateTime? @map("range_from")
  rangeTo      DateTime? @map("range_to")
  createdAt    DateTime  @default(now()) @map("created_at")

  uploadedBy User              @relation(fields: [uploadedById], references: [id])
  punches    AttendancePunch[]

  @@index([createdAt])
  @@map("attendance_imports")
}

// Cài đặt chung dạng khóa – giá trị (ví dụ leaveEscalateDays).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
