# Cấu hình API khi phát triển trên máy cá nhân. Sao chép thành .env rồi điền giá trị.
# Production dùng infra/.env (xem infra/.env.example).

# CSDL chạy bằng: docker compose -f infra/docker-compose.dev.yml up -d
DATABASE_URL=postgresql://taskmanager:taskmanager_dev@localhost:5432/taskmanager

# Địa chỉ giao diện web (Vite dev server)
APP_ORIGIN=http://localhost:5173

# Khóa mã hóa dữ liệu nhạy cảm (khóa OTP). Tạo bằng: openssl rand -hex 32
# MẤT KHÓA NÀY = mọi người dùng phải bật lại 2FA. Sao lưu riêng, không đưa vào Git.
APP_SECRET=

# Dev chạy http nên tắt cờ Secure của cookie. Production luôn để true.
COOKIE_SECURE=false

SESSION_TTL_HOURS=8
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
# Số lần gọi đăng nhập tối đa mỗi phút mỗi IP (chống dò mật khẩu)
LOGIN_RATE_LIMIT=5
# Vai trò bắt buộc bật xác thực hai lớp (để trống = không bắt buộc)
REQUIRE_2FA_ROLES=ADMIN,LEADER
PORT=3000
TZ=Asia/Ho_Chi_Minh

# ---- Nhắc việc qua thông báo đẩy (Web Push) ----
# Tạo cặp khóa: npx web-push generate-vapid-keys   (để trống = tắt thông báo đẩy)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:quantri@ten-truong.edu.vn

# ---- Nhắc việc qua thư điện tử ----
# Dev: dùng Mailpit trong infra/docker-compose.dev.yml (xem thư tại http://localhost:8025)
# Production: dùng máy chủ thư nội bộ của Nhà trường. Để trống SMTP_HOST = tắt thư.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hệ thống giao nhiệm vụ <no-reply@localhost>

# Dùng cho lệnh seed (tối thiểu 10 ký tự, có chữ và số)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DEMO_PASSWORD=
