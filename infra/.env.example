# Cấu hình production. Sao chép thành infra/.env, điền giá trị, rồi: chmod 600 .env
# Không đưa file .env vào Git.

# Tên miền của hệ thống (hoặc địa chỉ IP nội bộ, xem Caddyfile)
SITE_ADDRESS=giaoviec.ten-truong.edu.vn
APP_ORIGIN=https://giaoviec.ten-truong.edu.vn
# Máy chủ tại trường, chỉ mạng nội bộ, không có tên miền: SITE_ADDRESS=https://192.168.1.10, CADDY_TLS=tls internal
CADDY_TLS=

# Tạo bằng: openssl rand -hex 24   (chỉ dùng chữ và số để không lỗi chuỗi kết nối)
POSTGRES_PASSWORD=

# Tạo bằng: openssl rand -hex 32
# Sao lưu khóa này ở nơi an toàn: mất khóa thì mọi người dùng phải bật lại 2FA.
APP_SECRET=

SESSION_TTL_HOURS=8
# Vai trò bắt buộc bật xác thực hai lớp (ADMIN, LEADER, UNIT_HEAD, STAFF)
REQUIRE_2FA_ROLES=ADMIN,LEADER
MAX_UPLOAD_MB=20

# Thông báo đẩy: tạo bằng  npx web-push generate-vapid-keys  (để trống = tắt)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:quantri@ten-truong.edu.vn

# Thông báo đẩy về ứng dụng di động (để trống = tắt). Tệp đặt trong infra/secrets/, đường dẫn trong container:
#   FCM: tệp khóa tài khoản dịch vụ Firebase (Firebase Console → Project settings → Service accounts)
FCM_SERVICE_ACCOUNT_FILE=
#   APNs (gửi thẳng tới Apple, không qua Firebase): khóa .p8 tạo ở Apple Developer → Keys
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=vn.cdn20.giaoviec
APNS_ENV=production
# Ví dụ: FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-account.json, APNS_KEY_FILE=/run/secrets/apns-key.p8

# Thư nhắc việc: máy chủ thư nội bộ (để trống SMTP_HOST = tắt)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hệ thống giao nhiệm vụ <no-reply@ten-truong.edu.vn>

# Dùng cho lần chạy seed đầu tiên; sau khi tạo xong nên xóa ADMIN_PASSWORD khỏi file này.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
