# Cấu hình production. Sao chép thành infra/.env, điền giá trị, rồi: chmod 600 .env
# Không đưa file .env vào Git.

# Tên miền của hệ thống (hoặc địa chỉ IP nội bộ, xem Caddyfile)
SITE_ADDRESS=giaoviec.ten-truong.edu.vn
APP_ORIGIN=https://giaoviec.ten-truong.edu.vn

# Tạo bằng: openssl rand -hex 24   (chỉ dùng chữ và số để không lỗi chuỗi kết nối)
POSTGRES_PASSWORD=

# Tạo bằng: openssl rand -hex 32
# Sao lưu khóa này ở nơi an toàn: mất khóa thì mọi người dùng phải bật lại 2FA.
APP_SECRET=

SESSION_TTL_HOURS=8
MAX_UPLOAD_MB=20

# Dùng cho lần chạy seed đầu tiên; sau khi tạo xong nên xóa ADMIN_PASSWORD khỏi file này.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
