# SITE_ADDRESS, CADDY_TLS (infra/.env):
#   - Có tên miền trỏ về VPS:  SITE_ADDRESS=giaoviec.ten-truong.edu.vn, CADDY_TLS để trống
#     → Caddy tự xin chứng chỉ HTTPS (Let's Encrypt) và tự gia hạn
#   - Máy chủ tại trường, chỉ dùng mạng nội bộ (chưa có tên miền):  SITE_ADDRESS=https://192.168.1.10,
#     CADDY_TLS=tls internal → chứng chỉ do Caddy tự cấp; cài chứng chỉ gốc của Caddy lên máy người dùng
{$SITE_ADDRESS} {
	{$CADDY_TLS}

	# Luồng trò chuyện (Server-Sent Events) không nén, để tin nhắn tới ngay, không bị giữ lại chờ đủ khối nén.
	@compressible not path /api/chat/stream
	encode @compressible zstd gzip

	# Lớn hơn giới hạn tệp của API (MAX_UPLOAD_MB) một chút
	request_body {
		max_size 25MB
	}

	handle /api/chat/stream {
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Tệp có mã băm trong tên (assets/): lưu đệm lâu; index.html, sw.js: luôn kiểm tra bản mới.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@entry not path /assets/*
		header @entry Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		# Ant Design chèn style lúc chạy nên cần 'unsafe-inline' cho style-src
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 10
		}
	}
}
